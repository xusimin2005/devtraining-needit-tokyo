		GlideModal.get().destroy(); // 关闭对话框
		var url = new GlideURL('x_58872_needit_d1_list.do');
		g_navigation.open(url.getURL());
	}, 5000);
});

$j("#cancel").bind('click', function() {
	
	GlideModal.get().destroy(); // 关闭对话框
});]]></client_script>
